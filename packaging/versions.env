# Pinned inputs for packaging/build-release-app.sh. The build downloads each
# URL into its cache and refuses a sha256 mismatch. To bump one, update all
# three of its lines together (the sha256 from the release's asset digest,
# checked against a fresh download).

# CPython for the bundle: python-build-standalone, aarch64, install_only_stripped.
# Must stay on 3.14.x, matching the lock's cp314 wheels.
PYTHON_VERSION=3.14.10+20261110
PYTHON_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20261110/cpython-3.14.10%2B20261110-aarch64-apple-darwin-install_only_stripped.tar.gz
PYTHON_SHA256=f15ec3d15460dd66c2eb88639b152cd9040e7d1ece11e38bf89e8f53f0171e02

# uv, which syncs the hashed lock into Application Support on first launch.
UV_VERSION=0.13.8
UV_URL=https://github.com/astral-sh/uv/releases/download/0.13.8/uv-aarch64-apple-darwin.tar.gz
UV_SHA256=6b71028a6b904f2ae3340ef52e595512de807d06c0a20eaef2f692581b246558

# Sparkle 2: the framework, plus generate_keys and sign_update for releases.
SPARKLE_VERSION=2.10.1
SPARKLE_URL=https://github.com/sparkle-project/Sparkle/releases/download/2.10.1/Sparkle-2.10.1.tar.xz
SPARKLE_SHA256=1a856d2a9edb8e628de88121d7be04cf0e2167f8641650b78fca00b14244cf27
